#!/usr/bin/env bash
# =============================================================================
# Hook pre-push: valida el codi abans de deixar-lo pujar al remot.
#
# Comprova, en aquest ordre (fail-fast, del més ràpid al més lent):
#   1. lint   (eslint)
#   2. tests  (vitest run)
#   3. build  (next build)
#
# Si qualsevol pas falla, el push s'avorta amb codi d'error != 0.
#
# Activació (un sol cop per clon):
#   git config core.hooksPath .githooks
# =============================================================================
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/app"

echo "▶ pre-push: validant abans de pujar (lint → tests → build)…"

echo "→ [1/3] Lint…"
npm run lint

echo "→ [2/3] Tests…"
npm run test

echo "→ [3/3] Build…"
npm run build

echo "✔ pre-push: totes les validacions superades. Push permès."
